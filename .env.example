# ---- Backend ----
APP_ENV=development
DATABASE_URL=postgresql+psycopg://midad:midad_dev_password@postgres:5432/midad
JWT_SECRET=change-me-dev-only-32-chars-minimum-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-dev-only-32-chars-xxxx
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REDIS_URL=redis://redis:6379/0
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=midad-documents
CORS_ORIGINS=http://localhost:3000

# ---- Postgres container ----
POSTGRES_USER=midad
POSTGRES_PASSWORD=midad_dev_password
POSTGRES_DB=midad

